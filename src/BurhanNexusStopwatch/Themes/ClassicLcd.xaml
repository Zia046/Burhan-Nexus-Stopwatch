<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ClassicLcd theme -->
    <LinearGradientBrush x:Key="CaseBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF2B2F33" Offset="0" />
        <GradientStop Color="#FF17191C" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CaseBorderBrush" Color="#FF3C4248" />
    <SolidColorBrush x:Key="TitleForegroundBrush" Color="#FFE9ECEF" />
    <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#FF8D959C" />

    <LinearGradientBrush x:Key="LcdBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFD3DCC2" Offset="0" />
        <GradientStop Color="#FFB9C4A5" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LcdBorderBrush" Color="#FF0E100D" />
    <SolidColorBrush x:Key="LcdDigitBrush" Color="#FF1B2016" />
    <SolidColorBrush x:Key="LcdGhostBrush" Color="#161B2016" />
    <SolidColorBrush x:Key="LcdLabelBrush" Color="#FF3D4636" />

    <LinearGradientBrush x:Key="ButtonBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF3A3F45" Offset="0" />
        <GradientStop Color="#FF24282C" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF4A5158" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#33000000" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFE4E7EA" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FFF2A33A" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFE5675A" />

    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF202326" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF3A3F45" />
    <SolidColorBrush x:Key="ToggleTrackBrush" Color="#FF4A5158" />
    <SolidColorBrush x:Key="ToggleOnBrush" Color="#FFF2A33A" />
</ResourceDictionary>
