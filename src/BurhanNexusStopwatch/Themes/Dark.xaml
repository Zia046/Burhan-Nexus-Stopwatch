<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme -->
    <LinearGradientBrush x:Key="CaseBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF1B1E22" Offset="0" />
        <GradientStop Color="#FF0D0F11" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CaseBorderBrush" Color="#FF2C3136" />
    <SolidColorBrush x:Key="TitleForegroundBrush" Color="#FFE6E9EC" />
    <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#FF7F878F" />

    <LinearGradientBrush x:Key="LcdBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF0F1714" Offset="0" />
        <GradientStop Color="#FF0A100D" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LcdBorderBrush" Color="#FF000000" />
    <SolidColorBrush x:Key="LcdDigitBrush" Color="#FF7DF2B4" />
    <SolidColorBrush x:Key="LcdGhostBrush" Color="#1A7DF2B4" />
    <SolidColorBrush x:Key="LcdLabelBrush" Color="#FF4F8F70" />

    <LinearGradientBrush x:Key="ButtonBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF2A2F35" Offset="0" />
        <GradientStop Color="#FF1A1D21" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FF3A4047" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#33000000" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FFDDE2E6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF5BD9A0" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFEF6B5E" />

    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FF16191C" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF2C3136" />
    <SolidColorBrush x:Key="ToggleTrackBrush" Color="#FF3A4047" />
    <SolidColorBrush x:Key="ToggleOnBrush" Color="#FF5BD9A0" />
</ResourceDictionary>
