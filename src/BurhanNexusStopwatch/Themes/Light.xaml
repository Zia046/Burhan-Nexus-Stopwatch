<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme -->
    <LinearGradientBrush x:Key="CaseBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF4F5F7" Offset="0" />
        <GradientStop Color="#FFDCDFE3" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CaseBorderBrush" Color="#FFC3C8CE" />
    <SolidColorBrush x:Key="TitleForegroundBrush" Color="#FF23272C" />
    <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#FF6B737B" />

    <LinearGradientBrush x:Key="LcdBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFF6F8F1" Offset="0" />
        <GradientStop Color="#FFE4E9D8" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LcdBorderBrush" Color="#FF9AA190" />
    <SolidColorBrush x:Key="LcdDigitBrush" Color="#FF1E2328" />
    <SolidColorBrush x:Key="LcdGhostBrush" Color="#121E2328" />
    <SolidColorBrush x:Key="LcdLabelBrush" Color="#FF5D6670" />

    <LinearGradientBrush x:Key="ButtonBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0" />
        <GradientStop Color="#FFE9ECEF" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#FFB9BFC6" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#26000000" />
    <SolidColorBrush x:Key="ButtonForegroundBrush" Color="#FF23272C" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FFD9822B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFD2483A" />

    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFF7F8FA" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#FFD0D5DB" />
    <SolidColorBrush x:Key="ToggleTrackBrush" Color="#FFC3C8CE" />
    <SolidColorBrush x:Key="ToggleOnBrush" Color="#FFD9822B" />
</ResourceDictionary>
