<Window x:Class="BurhanNexusStopwatch.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About - Burhan Nexus Stopwatch"
        Width="340" SizeToContent="Height"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Clickable contact value (opens phone / mail app) -->
        <Style x:Key="ContactLink" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Text" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent"
                                   TextTrimming="CharacterEllipsis" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small square icon button (copy) -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TitleForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContactCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CaseBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="10,8,6,8" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="ContactIcon" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style x:Key="SmallCaps" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource CaseBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Background="{DynamicResource CaseBrush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,1,8,0" />
                    <TextBlock Text="About" FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TitleForegroundBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        Width="40" Click="Close_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="18,16,18,12">

                <!-- Official Burhan Nexus logo (original file, uniform scaling only) -->
                <Border Background="Black" CornerRadius="10" Padding="14,10"
                        BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                    <Image Source="/Assets/BurhanNexusLogo.jpg" Stretch="Uniform" MaxHeight="88"
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <!-- Software information -->
                <TextBlock x:Name="ProductText" Text="Burhan Nexus Stopwatch" HorizontalAlignment="Center"
                           Margin="0,14,0,0" FontFamily="{StaticResource UiFont}" FontSize="17" FontWeight="Bold"
                           Foreground="{DynamicResource TitleForegroundBrush}" />

                <Border HorizontalAlignment="Center" Margin="0,6,0,0" Padding="10,2" CornerRadius="9"
                        BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
                    <TextBlock x:Name="VersionText" Text="Version 1.0.0" FontFamily="{StaticResource UiFont}"
                               FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                </Border>

                <TextBlock x:Name="DescriptionText" Style="{StaticResource BodyText}" TextAlignment="Center"
                           Margin="4,10,4,0" FontSize="11.5" LineHeight="17"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />

                <Border Height="1" Background="{DynamicResource PanelBorderBrush}" Margin="0,14,0,12" />

                <!-- Developer -->
                <TextBlock Text="DEVELOPED &amp; PUBLISHED BY" Style="{StaticResource SmallCaps}" HorizontalAlignment="Center" />
                <TextBlock x:Name="DeveloperText" Text="Burhan Nexus" HorizontalAlignment="Center" Margin="0,3,0,0"
                           FontFamily="{StaticResource UiFont}" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource TitleForegroundBrush}" />

                <!-- Contact -->
                <TextBlock Text="CONTACT" Style="{StaticResource SmallCaps}" Margin="2,14,0,6" />

                <Border Style="{StaticResource ContactCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ContactIcon}">
                            <TextBlock Text="&#xE717;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Mobile" Style="{StaticResource SmallCaps}" />
                            <Button x:Name="MobileLink" Style="{StaticResource ContactLink}" Content="+000"
                                    Click="MobileLink_Click" ToolTip="Call this number" />
                        </StackPanel>
                        <Button x:Name="CopyMobileButton" Grid.Column="2" Style="{StaticResource IconButton}"
                                Content="&#xE8C8;" Click="CopyMobile_Click" ToolTip="Copy mobile number" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource ContactCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource ContactIcon}">
                            <TextBlock Text="&#xE715;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Email" Style="{StaticResource SmallCaps}" />
                            <Button x:Name="EmailLink" Style="{StaticResource ContactLink}" Content="email"
                                    Click="EmailLink_Click" ToolTip="Send an email" />
                        </StackPanel>
                        <Button x:Name="CopyEmailButton" Grid.Column="2" Style="{StaticResource IconButton}"
                                Content="&#xE8C8;" Click="CopyEmail_Click" ToolTip="Copy email address" />
                    </Grid>
                </Border>

                <!-- Feedback line (e.g. "Copied to clipboard") -->
                <TextBlock x:Name="StatusText" HorizontalAlignment="Center" Margin="0,2,0,0" MinHeight="14"
                           FontFamily="{StaticResource UiFont}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" />

                <TextBlock x:Name="CopyrightText" HorizontalAlignment="Center" Margin="0,6,0,0"
                           FontFamily="{StaticResource UiFont}" FontSize="10"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource CaseBrush}" Padding="12,10">
                <Button Content="OK" Width="84" Height="28" HorizontalAlignment="Right" IsDefault="True" IsCancel="True"
                        Style="{StaticResource WatchButton}" Foreground="{DynamicResource AccentBrush}" />
            </Border>
        </Grid>
    </Border>
</Window>
