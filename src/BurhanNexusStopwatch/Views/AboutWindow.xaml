<Window x:Class="BurhanNexusStopwatch.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About - Burhan Nexus Stopwatch"
        Width="320" SizeToContent="Height"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource CaseBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Background="{DynamicResource CaseBrush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,1,8,0" />
                    <TextBlock Text="About" FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TitleForegroundBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        Width="40" Click="Close_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="22,18,22,14">
                <!-- Branding -->
                <Border Width="76" Height="76" CornerRadius="16" HorizontalAlignment="Center"
                        Background="{DynamicResource CaseBrush}" BorderBrush="{DynamicResource CaseBorderBrush}"
                        BorderThickness="1" Padding="6">
                    <Image Source="/Assets/Logo.png" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <TextBlock x:Name="ProductText" Text="Burhan Nexus Stopwatch" HorizontalAlignment="Center"
                           Margin="0,12,0,0" FontFamily="{StaticResource UiFont}" FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource TitleForegroundBrush}" />
                <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontFamily="{StaticResource UiFont}"
                           FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold">
                    <Run Text="Developed by " /><Run x:Name="DeveloperRun" Text="Burhan Nexus" />
                </TextBlock>

                <TextBlock x:Name="DescriptionText" Style="{StaticResource BodyText}" TextAlignment="Center"
                           Margin="0,12,0,0" FontSize="11.5"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />

                <Border Height="1" Background="{DynamicResource PanelBorderBrush}" Margin="0,14,0,10" />

                <!-- Developer information -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style x:Key="Key" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                            <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
                            <Setter Property="Margin" Value="0,3" />
                        </Style>
                        <Style x:Key="Value" TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Margin" Value="0,3" />
                        </Style>
                    </Grid.Resources>

                    <TextBlock Grid.Row="0" Text="Developed by" Style="{StaticResource Key}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DeveloperValue" Style="{StaticResource Value}" />
                    <TextBlock Grid.Row="1" Text="Mobile" Style="{StaticResource Key}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="MobileValue" Style="{StaticResource Value}" />
                    <TextBlock Grid.Row="2" Text="Email" Style="{StaticResource Key}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="EmailValue" Style="{StaticResource Value}" />
                    <TextBlock Grid.Row="3" Text="Version" Style="{StaticResource Key}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="VersionValue" Style="{StaticResource Value}" />
                </Grid>

                <TextBlock x:Name="CopyrightText" HorizontalAlignment="Center" Margin="0,14,0,0"
                           FontFamily="{StaticResource UiFont}" FontSize="10"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource CaseBrush}" Padding="12,10">
                <Button Content="OK" Width="84" Height="28" HorizontalAlignment="Right" IsDefault="True" IsCancel="True"
                        Style="{StaticResource WatchButton}" Foreground="{DynamicResource AccentBrush}" />
            </Border>
        </Grid>
    </Border>
</Window>
