<Window x:Class="BurhanNexusStopwatch.Views.SetTimerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set Timer - Burhan Nexus Stopwatch"
        Width="320" SizeToContent="Height"
        WindowStyle="SingleBorderWindow" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="0" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SpinButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UnitLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Colon" TargetType="TextBlock">
            <Setter Property="Text" Value=":" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{DynamicResource CaseBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Background="{DynamicResource CaseBrush}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="&#xE916;" FontFamily="{StaticResource IconFont}" FontSize="12"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,1,8,0" />
                    <TextBlock Text="Set Timer" FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TitleForegroundBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right"
                        Width="40" Click="Cancel_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="16,8,16,12">
                <TextBlock Text="QUICK PRESETS" Style="{StaticResource SectionLabel}" />
                <UniformGrid x:Name="PresetGrid" Columns="5" Margin="-3,6,-3,0" />

                <TextBlock Text="CUSTOM TIME" Style="{StaticResource SectionLabel}" Margin="0,12,0,6" />
                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Button Style="{StaticResource SpinButton}" Content="&#xE70E;" Tag="H+" Click="Spin_Click" ToolTip="More hours" />
                        <TextBox x:Name="HoursBox" Style="{StaticResource NumberBox}" Text="00" Tag="H" />
                        <Button Style="{StaticResource SpinButton}" Content="&#xE70D;" Tag="H-" Click="Spin_Click" ToolTip="Fewer hours" />
                        <TextBlock Text="HOURS" Style="{StaticResource UnitLabel}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Style="{StaticResource Colon}" Margin="0,0,0,16" />
                    <StackPanel Grid.Column="2">
                        <Button Style="{StaticResource SpinButton}" Content="&#xE70E;" Tag="M+" Click="Spin_Click" ToolTip="More minutes" />
                        <TextBox x:Name="MinutesBox" Style="{StaticResource NumberBox}" Text="05" Tag="M" />
                        <Button Style="{StaticResource SpinButton}" Content="&#xE70D;" Tag="M-" Click="Spin_Click" ToolTip="Fewer minutes" />
                        <TextBlock Text="MINUTES" Style="{StaticResource UnitLabel}" />
                    </StackPanel>
                    <TextBlock Grid.Column="3" Style="{StaticResource Colon}" Margin="0,0,0,16" />
                    <StackPanel Grid.Column="4">
                        <Button Style="{StaticResource SpinButton}" Content="&#xE70E;" Tag="S+" Click="Spin_Click" ToolTip="More seconds" />
                        <TextBox x:Name="SecondsBox" Style="{StaticResource NumberBox}" Text="00" Tag="S" />
                        <Button Style="{StaticResource SpinButton}" Content="&#xE70D;" Tag="S-" Click="Spin_Click" ToolTip="Fewer seconds" />
                        <TextBlock Text="SECONDS" Style="{StaticResource UnitLabel}" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ErrorText" HorizontalAlignment="Center" Margin="0,8,0,0" MinHeight="14"
                           FontFamily="{StaticResource UiFont}" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource DangerBrush}" />
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource CaseBrush}" Padding="12,10">
                <Grid>
                    <Button Content="CANCEL" Width="80" Height="28" HorizontalAlignment="Left" IsCancel="True"
                            Style="{StaticResource WatchButton}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="SET" Width="70" Height="28" Margin="0,0,8,0"
                                Style="{StaticResource WatchButton}" Click="Set_Click" ToolTip="Set the timer" />
                        <Button Content="SET &amp; START" Width="104" Height="28" IsDefault="True"
                                Style="{StaticResource WatchButton}" Foreground="{DynamicResource AccentBrush}"
                                Click="SetAndStart_Click" ToolTip="Set the timer and start counting down" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
