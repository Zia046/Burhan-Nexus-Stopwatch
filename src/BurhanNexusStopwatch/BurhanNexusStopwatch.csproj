<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BurhanNexusStopwatch</RootNamespace>
    <AssemblyName>BurhanNexusStopwatch</AssemblyName>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Product>Burhan Nexus Stopwatch</Product>
    <AssemblyTitle>Burhan Nexus Stopwatch</AssemblyTitle>
    <Company>Burhan Nexus</Company>
    <Authors>Burhan Nexus</Authors>
    <Copyright>Copyright © 2026 Burhan Nexus. All rights reserved.</Copyright>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\Logo.png" />
    <Resource Include="Assets\BurhanNexusLogo.jpg" />
  </ItemGroup>

</Project>
