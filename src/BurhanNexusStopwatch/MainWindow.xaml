<Window x:Class="BurhanNexusStopwatch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BurhanNexusStopwatch.Controls"
        Title="Burhan Nexus Stopwatch"
        Icon="Assets/AppIcon.ico"
        Width="300" Height="200"
        MinWidth="272" MinHeight="180"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="{DynamicResource CaseBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="28"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{DynamicResource CaseBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="22" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Custom title bar ===== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Source="Assets/Logo.png" Width="14" Height="14" Margin="9,0,6,0"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />

                <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontFamily="{StaticResource UiFont}" FontSize="10.5">
                    <Run Text="BURHAN NEXUS" FontWeight="Bold" Foreground="{DynamicResource TitleForegroundBrush}" />
                    <Run Text=" STOPWATCH" Foreground="{DynamicResource SubtleForegroundBrush}" />
                </TextBlock>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE921;"
                            ToolTip="Minimize" Click="MinimizeButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;"
                            ToolTip="Maximize" Click="MaximizeButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                            ToolTip="Close" Click="CloseButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
            </Grid>

            <!-- ===== Toolbar: Settings + About only ===== -->
            <Grid Grid.Row="1" Background="Transparent" Margin="5,0,8,0"
                  MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButton}" Click="SettingsButton_Click" ToolTip="Settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       VerticalAlignment="Center" Margin="0,1,5,0" />
                            <TextBlock Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButton}" Click="AboutButton_Click" ToolTip="About" Margin="2,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       VerticalAlignment="Center" Margin="0,1,5,0" />
                            <TextBlock Text="About" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="PinIndicator" Text="&#xE718;" FontFamily="{StaticResource IconFont}" FontSize="10"
                               Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"
                               ToolTip="Pinned on top of other windows" Visibility="Collapsed" />
                    <Border CornerRadius="9" Padding="1" BorderThickness="1"
                            BorderBrush="{DynamicResource PanelBorderBrush}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="StopwatchTab" GroupName="Mode" Content="STOPWATCH" IsChecked="True"
                                         Style="{StaticResource ModeTab}" Checked="ModeTab_Checked"
                                         ToolTip="Stopwatch" />
                            <RadioButton x:Name="TimerTab" GroupName="Mode" Content="TIMER"
                                         Style="{StaticResource ModeTab}" Checked="ModeTab_Checked"
                                         ToolTip="Countdown timer with alarm" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===== LCD screen ===== -->
            <Border x:Name="LcdBorder" Grid.Row="2" Margin="9,3,9,7" CornerRadius="6" BorderThickness="2"
                    Background="{DynamicResource LcdBackgroundBrush}"
                    BorderBrush="{DynamicResource LcdBorderBrush}"
                    Padding="8,5,8,4"
                    MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                <Viewbox Stretch="Uniform" StretchDirection="Both">
                    <StackPanel>
                        <!-- Clock + date row -->
                        <Grid x:Name="InfoRow" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel x:Name="ClockPanel" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <controls:SevenSegmentDisplay x:Name="ClockDisplay" DigitHeight="22" Text="12:00:00"
                                                              OnBrush="{DynamicResource LcdDigitBrush}"
                                                              OffBrush="{DynamicResource LcdGhostBrush}" />
                                <TextBlock x:Name="AmPmText" Text="AM" Margin="5,0,0,0" VerticalAlignment="Top"
                                           FontFamily="{StaticResource UiFont}" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource LcdDigitBrush}" />
                            </StackPanel>

                            <TextBlock x:Name="DateText" Grid.Column="2" Text="MON 01 JAN 2026"
                                       VerticalAlignment="Bottom" Margin="12,0,0,0"
                                       FontFamily="{StaticResource UiFont}" FontSize="12" FontWeight="Bold"
                                       Foreground="{DynamicResource LcdDigitBrush}" />
                        </Grid>

                        <!-- Shown instead of the clock row while the alarm rings -->
                        <TextBlock x:Name="TimesUpText" Text="TIME'S UP!" HorizontalAlignment="Center"
                                   Margin="0,0,0,4" Visibility="Collapsed"
                                   FontFamily="{StaticResource UiFont}" FontSize="22" FontWeight="Black"
                                   Foreground="{DynamicResource LcdDigitBrush}" />

                        <Grid>
                            <!-- Main stopwatch digits -->
                            <controls:SevenSegmentDisplay x:Name="MainDisplay" DigitHeight="58" Text="00:00:00.00"
                                                          HorizontalAlignment="Center"
                                                          OnBrush="{DynamicResource LcdDigitBrush}"
                                                          OffBrush="{DynamicResource LcdGhostBrush}" />
                            <!-- Countdown timer digits -->
                            <controls:SevenSegmentDisplay x:Name="TimerDisplay" DigitHeight="58" Text="00:05:00"
                                                          HorizontalAlignment="Center" Visibility="Collapsed"
                                                          OnBrush="{DynamicResource LcdDigitBrush}"
                                                          OffBrush="{DynamicResource LcdGhostBrush}" />
                        </Grid>

                        <!-- Mode / status labels -->
                        <Grid Margin="0,5,0,0">
                            <TextBlock x:Name="ModeText" Text="STOPWATCH" FontFamily="{StaticResource UiFont}" FontSize="9"
                                       FontWeight="Bold" Foreground="{DynamicResource LcdLabelBrush}" />
                            <TextBlock x:Name="OtherModeText" HorizontalAlignment="Center"
                                       FontFamily="{StaticResource UiFont}" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource LcdLabelBrush}" />
                            <TextBlock x:Name="StatusText" Text="READY" HorizontalAlignment="Right"
                                       FontFamily="{StaticResource UiFont}" FontSize="9" FontWeight="Bold"
                                       Foreground="{DynamicResource LcdLabelBrush}" />
                        </Grid>
                    </StackPanel>
                </Viewbox>
            </Border>

            <!-- ===== Stopwatch: START / PAUSE / RESET ===== -->
            <Grid x:Name="StopwatchButtons" Grid.Row="3" Margin="6,0,6,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="StartButton" Grid.Column="0" Margin="3,0" Height="28" Content="START"
                        Style="{StaticResource WatchButton}" Foreground="{DynamicResource AccentBrush}"
                        Click="StartButton_Click" ToolTip="Start / resume" />
                <Button x:Name="PauseButton" Grid.Column="1" Margin="3,0" Height="28" Content="PAUSE"
                        Style="{StaticResource WatchButton}" Click="PauseButton_Click" ToolTip="Pause" />
                <Button x:Name="ResetButton" Grid.Column="2" Margin="3,0" Height="28" Content="RESET"
                        Style="{StaticResource WatchButton}" Foreground="{DynamicResource DangerBrush}"
                        Click="ResetButton_Click" ToolTip="Reset to zero" />
            </Grid>

            <!-- ===== Timer: SET / START-PAUSE-RESUME / RESET ===== -->
            <Grid x:Name="TimerButtons" Grid.Row="3" Margin="6,0,6,8" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SetTimerButton" Grid.Column="0" Margin="3,0" Height="28" Content="SET"
                        Style="{StaticResource WatchButton}" Click="SetTimerButton_Click" ToolTip="Set timer duration" />
                <Button x:Name="TimerStartButton" Grid.Column="1" Margin="3,0" Height="28" Content="START"
                        Style="{StaticResource WatchButton}" Foreground="{DynamicResource AccentBrush}"
                        Click="TimerStartButton_Click" ToolTip="Start timer" />
                <Button x:Name="TimerResetButton" Grid.Column="2" Margin="3,0" Height="28" Content="RESET"
                        Style="{StaticResource WatchButton}" Foreground="{DynamicResource DangerBrush}"
                        Click="TimerResetButton_Click" ToolTip="Reset timer" />
            </Grid>

            <!-- ===== Alarm ringing ===== -->
            <Grid x:Name="AlarmButtons" Grid.Row="3" Margin="9,0,9,8" Visibility="Collapsed">
                <Button x:Name="StopAlarmButton" Height="28" Style="{StaticResource WatchButton}"
                        Foreground="{DynamicResource DangerBrush}" Click="StopAlarmButton_Click" ToolTip="Stop the alarm">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,1,7,0" />
                        <TextBlock Text="STOP ALARM" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
